package com.employeehub.service;

import com.employeehub.model.NoteAnnuelle;
import com.employeehub.repository.NoteAnnuelleRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;
import java.util.Optional;

/**
 * Service pour la gestion des notes annuelles
 */
@Service
@Transactional
public class NoteAnnuelleService {

    @Autowired
    private NoteAnnuelleRepository noteAnnuelleRepository;

    /**
     * Créer une nouvelle note annuelle
     */
    public NoteAnnuelle createNoteAnnuelle(NoteAnnuelle noteAnnuelle) {
        return noteAnnuelleRepository.save(noteAnnuelle);
    }

    /**
     * Récupérer toutes les notes annuelles
     */
    public List<NoteAnnuelle> getAllNotesAnnuelles() {
        return noteAnnuelleRepository.findAll();
    }

    /**
     * Récupérer une note annuelle par ID
     */
    public Optional<NoteAnnuelle> getNoteAnnuelleById(String id) {
        return noteAnnuelleRepository.findById(id);
    }

    /**
     * Récupérer les notes annuelles d'un employé
     */
    public List<NoteAnnuelle> getNotesByEmployee(String employeeId) {
        return noteAnnuelleRepository.findByEmployeeId(employeeId);
    }

    /**
     * Récupérer la note annuelle d'un employé pour une année
     */
    public Optional<NoteAnnuelle> getNoteByEmployeeAndYear(String employeeId, Integer annee) {
        return noteAnnuelleRepository.findByEmployeeIdAndAnnee(employeeId, annee);
    }

    /**
     * Récupérer les notes annuelles d'une année
     */
    public List<NoteAnnuelle> getNotesByYear(Integer annee) {
        return noteAnnuelleRepository.findByAnnee(annee);
    }

    /**
     * Récupérer les notes annuelles validées
     */
    public List<NoteAnnuelle> getNotesValidees() {
        return noteAnnuelleRepository.findByEstValideeTrue();
    }

    /**
     * Récupérer les notes annuelles non validées
     */
    public List<NoteAnnuelle> getNotesNonValidees() {
        return noteAnnuelleRepository.findByEstValideeFalse();
    }

    /**
     * Récupérer les notes annuelles par note minimale
     */
    public List<NoteAnnuelle> getNotesByMinimumNote(Double noteMinimum) {
        return noteAnnuelleRepository.findByNoteGeneraleGreaterThanEqual(noteMinimum);
    }

    /**
     * Calculer la moyenne des notes d'un employé
     */
    public Double calculateAverageNoteByEmployee(String employeeId) {
        Double average = noteAnnuelleRepository.calculateAverageNoteByEmployee(employeeId);
        return average != null ? average : 0.0;
    }

    /**
     * Mettre à jour une note annuelle
     */
    public NoteAnnuelle updateNoteAnnuelle(String id, NoteAnnuelle noteAnnuelleDetails) {
        NoteAnnuelle noteAnnuelle = noteAnnuelleRepository.findById(id)
            .orElseThrow(() -> new RuntimeException("Note annuelle non trouvée avec l'ID: " + id));

        noteAnnuelle.setEmployee(noteAnnuelleDetails.getEmployee());
        noteAnnuelle.setAnnee(noteAnnuelleDetails.getAnnee());
        noteAnnuelle.setNoteGenerale(noteAnnuelleDetails.getNoteGenerale());
        noteAnnuelle.setNoteCompetence(noteAnnuelleDetails.getNoteCompetence());
        noteAnnuelle.setNoteAssiduité(noteAnnuelleDetails.getNoteAssiduité());
        noteAnnuelle.setNoteComportement(noteAnnuelleDetails.getNoteComportement());
        noteAnnuelle.setObservations(noteAnnuelleDetails.getObservations());
        noteAnnuelle.setEvaluateur(noteAnnuelleDetails.getEvaluateur());
        noteAnnuelle.setEstValidee(noteAnnuelleDetails.getEstValidee());
        noteAnnuelle.setDateValidation(noteAnnuelleDetails.getDateValidation());
        noteAnnuelle.setValidateur(noteAnnuelleDetails.getValidateur());

        return noteAnnuelleRepository.save(noteAnnuelle);
    }

    /**
     * Valider une note annuelle
     */
    public NoteAnnuelle validateNoteAnnuelle(String id, String validateur) {
        NoteAnnuelle noteAnnuelle = noteAnnuelleRepository.findById(id)
            .orElseThrow(() -> new RuntimeException("Note annuelle non trouvée avec l'ID: " + id));
        
        noteAnnuelle.setEstValidee(true);
        noteAnnuelle.setDateValidation(java.time.LocalDate.now());
        noteAnnuelle.setValidateur(validateur);
        return noteAnnuelleRepository.save(noteAnnuelle);
    }

    /**
     * Supprimer une note annuelle
     */
    public void deleteNoteAnnuelle(String id) {
        noteAnnuelleRepository.deleteById(id);
    }

    /**
     * Compter les notes annuelles d'un employé
     */
    public long countByEmployee(String employeeId) {
        return noteAnnuelleRepository.countByEmployeeId(employeeId);
    }

    /**
     * Compter les notes annuelles validées
     */
    public long countNotesValidees() {
        return noteAnnuelleRepository.countByEstValideeTrue();
    }
}
