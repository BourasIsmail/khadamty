package com.employeehub.service;

import com.employeehub.model.Credit;
import com.employeehub.repository.CreditRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.math.BigDecimal;
import java.time.LocalDate;
import java.util.List;
import java.util.Optional;

/**
 * Service pour la gestion des crédits
 */
@Service
@Transactional
public class CreditService {

    @Autowired
    private CreditRepository creditRepository;

    /**
     * Créer un nouveau crédit
     */
    public Credit createCredit(Credit credit) {
        return creditRepository.save(credit);
    }

    /**
     * Récupérer tous les crédits
     */
    public List<Credit> getAllCredits() {
        return creditRepository.findAll();
    }

    /**
     * Récupérer un crédit par ID
     */
    public Optional<Credit> getCreditById(String id) {
        return creditRepository.findById(id);
    }

    /**
     * Récupérer les crédits d'un employé
     */
    public List<Credit> getCreditsByEmployee(String employeeId) {
        return creditRepository.findByEmployeeId(employeeId);
    }

    /**
     * Récupérer les crédits par type
     */
    public List<Credit> getCreditsByType(Credit.TypeCredit type) {
        return creditRepository.findByType(type);
    }

    /**
     * Récupérer les crédits d'un employé par type
     */
    public List<Credit> getCreditsByEmployeeAndType(String employeeId, Credit.TypeCredit type) {
        return creditRepository.findByEmployeeIdAndType(employeeId, type);
    }

    /**
     * Récupérer les crédits par statut
     */
    public List<Credit> getCreditsByStatut(Credit.StatutCredit statut) {
        return creditRepository.findByStatut(statut);
    }

    /**
     * Récupérer les crédits actifs d'un employé
     */
    public List<Credit> getActiveCredits(String employeeId) {
        return creditRepository.findActiveCredits(employeeId);
    }

    /**
     * Récupérer les crédits soldés d'un employé
     */
    public List<Credit> getSoldedCredits(String employeeId) {
        return creditRepository.findSoldedCredits(employeeId);
    }

    /**
     * Calculer le montant total des crédits d'un employé
     */
    public Double calculateTotalCreditByEmployee(String employeeId) {
        Double total = creditRepository.calculateTotalCreditByEmployee(employeeId);
        return total != null ? total : 0.0;
    }

    /**
     * Calculer le montant restant des crédits d'un employé
     */
    public Double calculateMontantRestantByEmployee(String employeeId) {
        Double total = creditRepository.calculateMontantRestantByEmployee(employeeId);
        return total != null ? total : 0.0;
    }

    /**
     * Mettre à jour un crédit
     */
    public Credit updateCredit(String id, Credit creditDetails) {
        Credit credit = creditRepository.findById(id)
            .orElseThrow(() -> new RuntimeException("Crédit non trouvé avec l'ID: " + id));

        credit.setEmployee(creditDetails.getEmployee());
        credit.setType(creditDetails.getType());
        credit.setOrganisme(creditDetails.getOrganisme());
        credit.setMontantTotal(creditDetails.getMontantTotal());
        credit.setMontantMensuel(creditDetails.getMontantMensuel());
        credit.setMontantPaye(creditDetails.getMontantPaye());
        credit.setMontantRestant(creditDetails.getMontantRestant());
        credit.setDateDebut(creditDetails.getDateDebut());
        credit.setDateFin(creditDetails.getDateFin());
        credit.setDureeMois(creditDetails.getDureeMois());
        credit.setTauxInteret(creditDetails.getTauxInteret());
        credit.setStatut(creditDetails.getStatut());
        credit.setObservations(creditDetails.getObservations());

        return creditRepository.save(credit);
    }

    /**
     * Enregistrer un paiement de crédit
     */
    public Credit recordPayment(String id, BigDecimal montantPaye) {
        Credit credit = creditRepository.findById(id)
            .orElseThrow(() -> new RuntimeException("Crédit non trouvé avec l'ID: " + id));
        
        BigDecimal nouveauMontantPaye = credit.getMontantPaye().add(montantPaye);
        BigDecimal nouveauMontantRestant = credit.getMontantTotal().subtract(nouveauMontantPaye);
        
        credit.setMontantPaye(nouveauMontantPaye);
        credit.setMontantRestant(nouveauMontantRestant);
        
        // Mettre à jour le statut si le crédit est soldé
        if (nouveauMontantRestant.compareTo(BigDecimal.ZERO) <= 0) {
            credit.setStatut(Credit.StatutCredit.SOLDE);
        }
        
        return creditRepository.save(credit);
    }

    /**
     * Supprimer un crédit
     */
    public void deleteCredit(String id) {
        creditRepository.deleteById(id);
    }

    /**
     * Compter les crédits d'un employé
     */
    public long countByEmployee(String employeeId) {
        return creditRepository.countByEmployeeId(employeeId);
    }

    /**
     * Compter les crédits par statut
     */
    public long countByStatut(Credit.StatutCredit statut) {
        return creditRepository.countByStatut(statut);
    }
}
