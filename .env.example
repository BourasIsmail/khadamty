# Copy to .env (never commit .env) and fill in real values.
DB_USERNAME=root
DB_PASSWORD=change-me
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars

# SMTP for welcome emails (Gmail: use an app password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Development only: seed demo users/structures on first run
SEED_DEMO_DATA=false
SEED_ADMIN_PASSWORD=
